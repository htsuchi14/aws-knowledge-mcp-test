# terraform.tfvars.example
aws_region             = "ap-northeast-1"
aws_profile            = "terraform-mcp-test"
project_name           = "webapp"
environment            = "production"
vpc_cidr               = "10.0.0.0/16"
db_name                = "webapp"
db_username            = "admin"
db_instance_class      = "db.t4g.micro"
db_allocated_storage   = 20
